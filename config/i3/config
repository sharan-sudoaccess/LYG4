# ~/.config/i3/config  —  keyboard-first i3 setup
# Super = $mod. Colors come from theme.conf (written by dt-theme).

set $mod Mod4
# kitty and rofi use devdesk's own configs, so other desktops on this
# machine (e.g. a Hyprland setup) keep their ~/.config/kitty and ~/.config/rofi
set $term kitty --config ~/.config/devdesk/kitty/kitty.conf
set $rofi rofi -config ~/.config/devdesk/rofi/config.rasi
set $bin ~/.local/bin

font pango:JetBrains Mono 10
include ~/.config/i3/theme.conf

# --- look -------------------------------------------------------------------
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart
gaps inner 8
gaps outer 2
smart_gaps on
focus_follows_mouse no

# --- autostart --------------------------------------------------------------
exec --no-startup-id picom -b
exec --no-startup-id dunst
exec --no-startup-id $bin/dt-theme wallpaper
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec --no-startup-id $term --name dropdown

# --- workspaces (named, apps auto-assigned) ---------------------------------
set $ws1 "1:term"
set $ws2 "2:web"
set $ws3 "3:code"
set $ws4 "4:chat"
set $ws5 "5:media"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

assign [class="(?i)firefox|chromium|brave|google-chrome"] $ws2
assign [class="(?i)^code$|code-oss|jetbrains|sublime"]     $ws3
assign [class="(?i)discord|slack|telegram|signal"]        $ws4
assign [class="(?i)vlc|mpv|spotify"]                      $ws5
for_window [class="(?i)spotify"] move to workspace $ws5

for_window [class="(?i)pavucontrol|blueman|nm-connection-editor"] floating enable
for_window [window_role="pop-up|dialog"] floating enable

# drop-down terminal that lives in the scratchpad (Super+-, re-opens if closed)
for_window [instance="dropdown"] floating enable, resize set 1100 560, move position center, move scratchpad

# --- launchers --------------------------------------------------------------
bindsym $mod+Return       exec $term
bindsym $mod+d            exec --no-startup-id $rofi -show drun
bindsym $mod+Tab          exec --no-startup-id $rofi -show window
bindsym $mod+t            exec --no-startup-id $bin/dt-theme menu
bindsym $mod+i            exec --no-startup-id $bin/dt-sysinfo --notify
bindsym $mod+Shift+i      exec $term --class floating-sysinfo -e $bin/dt-sysinfo --watch
bindsym $mod+f            exec --no-startup-id $bin/dt-focus
bindsym $mod+slash        exec --no-startup-id $bin/dt-keys
bindsym $mod+Escape       exec --no-startup-id $bin/dt-power
bindsym $mod+minus        exec --no-startup-id "i3-msg -q '[instance=dropdown] scratchpad show' || $term --name dropdown"
for_window [class="floating-sysinfo"] floating enable, resize set 520 220, move position center

# --- screenshots (saved to ~/Pictures/Screenshots + copied to clipboard) ----
bindsym Print             exec --no-startup-id $bin/dt-shot full
bindsym Shift+Print       exec --no-startup-id $bin/dt-shot area
bindsym $mod+Print        exec --no-startup-id $bin/dt-shot window
bindsym $mod+Shift+s      exec --no-startup-id $bin/dt-shot area

# --- media keys -------------------------------------------------------------
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute        exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle

# --- windows ----------------------------------------------------------------
bindsym $mod+q kill
floating_modifier $mod

# vim keys + arrows
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+Shift+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# --- workspace switching ----------------------------------------------------
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9

bindsym $mod+bracketright workspace next
bindsym $mod+bracketleft  workspace prev
bindsym $mod+grave        workspace back_and_forth

# --- resize mode ------------------------------------------------------------
mode "resize" {
    bindsym h resize shrink width 20 px
    bindsym j resize grow height 20 px
    bindsym k resize shrink height 20 px
    bindsym l resize grow width 20 px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# --- session ----------------------------------------------------------------
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+x exec --no-startup-id $bin/dt-power lock
bindsym $mod+Shift+e exec --no-startup-id $bin/dt-power
