# Base dunst config. dt-theme appends colors and writes ~/.config/dunst/dunstrc
[global]
    font = JetBrains Mono 10
    origin = top-right
    offset = 14x40
    width = 320
    notification_limit = 5
    padding = 10
    horizontal_padding = 12
    frame_width = 2
    corner_radius = 8
    gap_size = 6
    format = "<b>%s</b>\n%b"
    timeout = 4
    mouse_left_click = close_current
