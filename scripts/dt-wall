#!/usr/bin/env bash
# dt-wall — wallpaper picker (Super+w).
# Shows the images in ~/Pictures/Wallpapers as a grid of thumbnails, with the
# current wallpaper as a banner on top.
#
#   Enter        set the wallpaper and recolor the desktop to match it
#   Alt+Enter    set the wallpaper only, keep the current colors
#   "Random"     pick one for you
#
#   dt-wall               open the picker
#   dt-wall <image>       set <image> + matching colors, no menu

CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
BIN="$(dirname "$(readlink -f "$0")")"
PICS="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")"
# use an existing ~/Pictures/wallpapers (e.g. from JaKooLit's setup) if there is one
DIR="${DT_WALLPAPERS:-$PICS/Wallpapers}"
[[ -z ${DT_WALLPAPERS:-} && ! -d $DIR && -d $PICS/wallpapers ]] && DIR="$PICS/wallpapers"
THUMBS="${XDG_CACHE_HOME:-$HOME/.cache}/devdesk/thumbs"
IM="$(command -v magick || command -v convert)"

apply() {  # apply <image> <colors|keep>
    if [[ $2 == keep ]]; then
        echo "$1" > "$CFG/devdesk/wallpaper-override"
        "$BIN/dt-theme" wallpaper
        notify-send -t 2000 -i "$1" "Wallpaper" "$(basename "$1")" 2>/dev/null
    else
        "$BIN/dt-theme" wall "$1" >/dev/null                  # notifies by itself
    fi
}

if [[ -n ${1:-} ]]; then apply "$(readlink -f "$1")" colors; exit; fi

mkdir -p "$DIR" "$THUMBS"
mapfile -t walls < <(find -L "$DIR" -maxdepth 2 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) | sort)
if (( ${#walls[@]} == 0 )); then
    notify-send "Wallpapers" "No images yet — put some .jpg / .png files in $DIR"
    exit 0
fi

# 16:9 thumbnails, cached by path + modification time, so the menu opens fast
thumb() {
    local key t
    key=$(printf '%s %s' "$1" "$(stat -c %Y "$1")" | md5sum | cut -c1-16)
    t="$THUMBS/$key.png"
    if [[ ! -f $t && -n $IM ]]; then
        "$IM" "$1[0]" -thumbnail 400x225^ -gravity center -extent 400x225 "$t" 2>/dev/null
    fi
    [[ -f $t ]] && echo "$t" || echo "$1"
}

entries() {
    printf 'Random\0icon\x1f%s\n' "$(thumb "${walls[RANDOM % ${#walls[@]}]}")"
    local f name
    for f in "${walls[@]}"; do
        name=$(basename "$f")
        printf '%s\0icon\x1f%s\n' "$name" "$(thumb "$f")"
    done
}

# banner = the wallpaper that's on screen now
current=$(cat "$CFG/devdesk/current-wallpaper" 2>/dev/null)
banner="inputbar { background-color: @bg-alt; }"
[[ -f $current ]] && banner="inputbar { background-image: url(\"$current\", width); }"

layout="
window   { width: 76%; padding: 10px; border-radius: 12px; }
mainbox  { children: [inputbar, listview]; spacing: 14px; }
$banner
inputbar { padding: 14px 14px 150px 14px; border-radius: 10px; children: [entry]; }
entry    { expand: false; width: 40%; padding: 10px 14px; border-radius: 8px;
           background-color: #000000aa; text-color: #ffffff;
           placeholder: \"  Search / Choose Wallpaper\"; placeholder-color: #ffffffcc; }
listview { columns: 6; lines: 2; flow: horizontal; spacing: 14px; fixed-columns: true; }
element  { orientation: vertical; padding: 6px 6px 10px 6px; spacing: 8px; border-radius: 10px;
           border: 3px; border-color: transparent; }
element selected.normal { background-color: @bg-alt; text-color: @accent; border-color: @accent; }
element-icon { size: 210px; border-radius: 8px; }
element-text { horizontal-align: 0.5; }
"

idx=$(entries | rofi -config "$CFG/devdesk/rofi/config.rasi" -dmenu -i -show-icons \
      -format i -p wallpaper -kb-custom-1 "Alt+Return" -theme-str "$layout")
rc=$?
[[ -z $idx ]] && exit 0                                  # Esc

if (( idx == 0 )); then pick="${walls[RANDOM % ${#walls[@]}]}"; else pick="${walls[idx-1]}"; fi
case $rc in
    0)  apply "$pick" colors ;;
    10) apply "$pick" keep ;;                            # Alt+Enter
esac
