#!/usr/bin/env bash
# dt-focus — "do not disturb" toggle for deep work.
# Hides polybar, pauses notifications and removes gaps. Run again to undo.

flag="${XDG_RUNTIME_DIR:-/tmp}/dt-focus.on"

if [[ -f $flag ]]; then
    mins=$(( ($(date +%s) - $(stat -c %Y "$flag")) / 60 ))
    rm -f "$flag"
    polybar-msg cmd show   >/dev/null 2>&1
    i3-msg -q 'gaps inner all set 8'
    dunstctl set-paused false
    notify-send -t 2000 "Focus mode" "off — you focused for ${mins} min"
else
    notify-send -t 1500 "Focus mode" "on — notifications paused"
    sleep 1.5
    touch "$flag"
    polybar-msg cmd hide   >/dev/null 2>&1
    i3-msg -q 'gaps inner all set 0'
    dunstctl set-paused true
fi
