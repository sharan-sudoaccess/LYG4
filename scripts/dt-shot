#!/usr/bin/env bash
# dt-shot — screenshots with maim.
#   dt-shot full | area | window
# Saves to ~/Pictures/Screenshots and copies the image to the clipboard.
set -euo pipefail

dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"

case "${1:-full}" in
    full)   maim "$file" ;;
    area)   maim -s -u "$file" || exit 0 ;;          # Esc cancels selection
    window) maim -i "$(xdotool getactivewindow)" "$file" ;;
    *)      echo "usage: dt-shot full|area|window" >&2; exit 1 ;;
esac

xclip -selection clipboard -t image/png -i "$file"
notify-send -t 2500 -i "$file" "Screenshot saved" "$(basename "$file") (copied)"
