#!/usr/bin/env bash
# dt-sysinfo — CPU, RAM and battery in one line.
# On machines without a battery it shows CPU temperature (or disk usage).
#
#   dt-sysinfo            one line (used by polybar, refreshed every 3s)
#   dt-sysinfo --watch    live view in the terminal (Ctrl+C to quit)
#   dt-sysinfo --notify   send it as a desktop notification

cpu_usage() {
    # two samples of /proc/stat, 0.4s apart
    local a b
    read -r _ a1 a2 a3 a4 a5 a6 a7 _ < /proc/stat
    sleep 0.4
    read -r _ b1 b2 b3 b4 b5 b6 b7 _ < /proc/stat
    a=$((a1+a2+a3+a4+a5+a6+a7)); b=$((b1+b2+b3+b4+b5+b6+b7))
    local total=$((b - a)) idle=$(( (b4+b5) - (a4+a5) ))
    (( total > 0 )) && echo $(( 100 * (total - idle) / total )) || echo 0
}

ram_usage() {
    awk '/^MemTotal/ {t=$2} /^MemAvailable/ {a=$2}
         END { printf "%d %.1f %.1f\n", (t-a)*100/t, (t-a)/1048576, t/1048576 }' /proc/meminfo
}

battery() {
    local bat
    for bat in /sys/class/power_supply/BAT*; do
        [[ -r $bat/capacity ]] || continue
        local cap status icon
        cap=$(<"$bat/capacity"); status=$(<"$bat/status")
        case $status in Charging) icon="+";; Full) icon="=";; *) icon="";; esac
        echo "BAT ${cap}%${icon}"
        return 0
    done
    return 1
}

# fallback metric for desktops
temperature() {
    local z type
    for z in /sys/class/thermal/thermal_zone*; do
        [[ -r $z/temp ]] || continue
        type=$(<"$z/type")
        if [[ $type == x86_pkg_temp || $type == k10temp || $type == coretemp || $type == acpitz ]]; then
            echo "TEMP $(( $(<"$z/temp") / 1000 ))°C"; return 0
        fi
    done
    return 1
}

disk() { df -h / | awk 'NR==2 {print "DISK " $5}'; }

extra() { battery || temperature || disk; }

bar() {  # bar <percent> <width>
    local p=$1 w=${2:-20} filled
    filled=$(( p * w / 100 ))
    printf '%*s' "$filled" '' | tr ' ' '#'
    printf '%*s' "$(( w - filled ))" '' | tr ' ' '.'
}

line() {
    local cpu ram
    cpu=$(cpu_usage)
    read -r ram _ _ < <(ram_usage)
    printf 'CPU %2d%%  RAM %2d%%  %s\n' "$cpu" "$ram" "$(extra)"
}

watch_mode() {
    trap 'tput cnorm; echo; exit 0' INT TERM
    tput civis
    while true; do
        local cpu ram used total
        cpu=$(cpu_usage)
        read -r ram used total < <(ram_usage)
        clear
        printf '\n  %-6s [%s] %3d%%\n' "CPU" "$(bar "$cpu" 30)" "$cpu"
        printf '  %-6s [%s] %3d%%  (%s / %s GiB)\n' "RAM" "$(bar "$ram" 30)" "$ram" "$used" "$total"
        printf '  %s\n\n' "$(extra)"
        printf '  load: %s   up: %s\n' "$(cut -d' ' -f1-3 /proc/loadavg)" "$(uptime -p | sed 's/^up //')"
        printf '\n  refreshing every %ss — Ctrl+C to quit\n' "${1:-2}"
        sleep "${1:-2}"
    done
}

case "${1:-}" in
    --watch)  watch_mode "${2:-2}" ;;
    --notify) notify-send -t 4000 "System" "$(line)" ;;
    *)        line ;;
esac
