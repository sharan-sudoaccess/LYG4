#!/usr/bin/env bash
# dt-sysinfo — CPU, RAM and battery in one line.
# On machines without a battery it shows CPU temperature (or disk usage).
#
#   dt-sysinfo            plain one line
#   dt-sysinfo --bar      colored line for polybar (turns yellow/red under load)
#   dt-sysinfo --watch    live view in the terminal (Ctrl+C to quit)
#   dt-sysinfo --notify   send it as a desktop notification

COLORS="${XDG_CONFIG_HOME:-$HOME/.config}/devdesk/colors.sh"
CACHE="${XDG_RUNTIME_DIR:-/tmp}/dt-sysinfo.$UID"

cpu_sample() {  # prints "<busy> <total>" jiffies since boot
    local u n s i w q sq st
    read -r _ u n s i w q sq st _ < /proc/stat
    echo "$(( u + n + s + q + sq + st )) $(( u + n + s + i + w + q + sq + st ))"
}

# CPU usage since the last call. The previous sample is kept in $CACHE, so the
# bar never has to sleep — each run is instant and costs almost nothing.
cpu_usage() {
    local busy total pbusy ptotal
    read -r busy total < <(cpu_sample)
    # no previous sample, or it is too fresh to mean anything (< ~0.25s): sample again
    if ! read -r pbusy ptotal 2>/dev/null < "$CACHE" || (( total - ptotal < 25 * $(nproc) )); then
        sleep 0.3
        read -r pbusy ptotal <<< "$busy $total"
        read -r busy total < <(cpu_sample)
    fi
    echo "$busy $total" > "$CACHE"
    echo $(( 100 * (busy - pbusy) / (total - ptotal) ))
}

ram_usage() {  # prints "<percent> <used GiB> <total GiB>"
    awk '/^MemTotal/ {t=$2} /^MemAvailable/ {a=$2}
         END { printf "%d %.1f %.1f\n", (t-a)*100/t, (t-a)/1048576, t/1048576 }' /proc/meminfo
}

# third metric: battery on laptops, temperature (or disk) on desktops
# prints "<label> <value> <suffix> <level>"  level: 0 ok, 1 warn, 2 bad
battery() {
    local bat cap status mark level=0
    for bat in /sys/class/power_supply/BAT*; do
        [[ -r $bat/capacity ]] || continue
        cap=$(<"$bat/capacity"); status=$(<"$bat/status")
        case $status in Charging) mark="+";; Full) mark="=";; *) mark="";; esac
        if [[ $status != Charging ]]; then
            (( cap <= 30 )) && level=1
            (( cap <= 15 )) && level=2
        fi
        echo "BAT $cap %$mark $level"
        return 0
    done
    return 1
}

temperature() {
    local z t
    for z in /sys/class/thermal/thermal_zone*; do
        [[ -r $z/temp ]] || continue
        case $(<"$z/type") in
            x86_pkg_temp|k10temp|coretemp|acpitz|cpu-thermal)
                t=$(( $(<"$z/temp") / 1000 ))
                echo "TEMP $t °C $(( t >= 85 ? 2 : t >= 70 ? 1 : 0 ))"
                return 0 ;;
        esac
    done
    return 1
}

disk() {
    local p
    p=$(df --output=pcent / | tail -1 | tr -dc 0-9)
    echo "DISK $p % $(( p >= 90 ? 2 : p >= 75 ? 1 : 0 ))"
}

extra() { battery || temperature || disk; }

level() { echo $(( $1 >= 85 ? 2 : $1 >= 60 ? 1 : 0 )); }

plain() {
    local cpu ram label val suf
    cpu=$(cpu_usage)
    read -r ram _ _ < <(ram_usage)
    read -r label val suf _ < <(extra)
    printf 'CPU %2d%%  RAM %2d%%  %s %s%s\n' "$cpu" "$ram" "$label" "$val" "$suf"
}

bar_line() {
    # shellcheck source=/dev/null
    [[ -r $COLORS ]] && source "$COLORS"
    local ok="${fg:-#dddddd}" warn="${color3:-#e5c07b}" bad="${urgent:-#e06c75}" key="${accent:-#88c0d0}"
    local cols=("$ok" "$warn" "$bad")
    local cpu ram label val suf lvl
    cpu=$(cpu_usage)
    read -r ram _ _ < <(ram_usage)
    read -r label val suf lvl < <(extra)
    # note: a space before every %{F-} — polybar reads "%%{" as an escaped "%{"
    printf '%%{F%s}CPU%%{F-} %%{F%s}%d%% %%{F-} ' "$key" "${cols[$(level "$cpu")]}" "$cpu"
    printf '%%{F%s}RAM%%{F-} %%{F%s}%d%% %%{F-} ' "$key" "${cols[$(level "$ram")]}" "$ram"
    printf '%%{F%s}%s%%{F-} %%{F%s}%s%s %%{F-}\n' "$key" "$label" "${cols[$lvl]}" "$val" "$suf"
}

meter() {  # meter <percent> <width>
    local p=$1 w=${2:-20} filled
    filled=$(( p * w / 100 ))
    printf '%*s' "$filled" '' | tr ' ' '#'
    printf '%*s' "$(( w - filled ))" '' | tr ' ' '.'
}

watch_mode() {
    local every=${1:-2} cpu ram used total label val suf
    trap 'tput cnorm; echo; exit 0' INT TERM
    tput civis
    while true; do
        cpu=$(cpu_usage)
        read -r ram used total < <(ram_usage)
        read -r label val suf _ < <(extra)
        clear
        printf '\n  %-5s [%s] %3d%%\n' "CPU" "$(meter "$cpu" 30)" "$cpu"
        printf '  %-5s [%s] %3d%%  (%s / %s GiB)\n' "RAM" "$(meter "$ram" 30)" "$ram" "$used" "$total"
        if [[ $suf == "%"* ]]; then
            printf '  %-5s [%s] %3d%s\n' "$label" "$(meter "$val" 30)" "$val" "$suf"
        else
            printf '  %-5s %s%s\n' "$label" "$val" "$suf"
        fi
        printf '\n  load %s   up %s\n' "$(cut -d' ' -f1-3 /proc/loadavg)" "$(uptime -p | sed 's/^up //')"
        printf '\n  refreshing every %ss — Ctrl+C to quit\n' "$every"
        sleep "$every"
    done
}

case "${1:-}" in
    --bar)    bar_line ;;
    --watch)  watch_mode "${2:-2}" ;;
    --notify) notify-send -t 4000 "System" "$(plain)" ;;
    *)        plain ;;
esac
