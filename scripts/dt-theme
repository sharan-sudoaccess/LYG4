#!/usr/bin/env bash
# dt-theme — switch the whole desktop between themes in one go.
#
#   dt-theme set <name>   apply a theme (gruvbox | nord | catppuccin)
#   dt-theme menu         pick a theme with rofi
#   dt-theme list         list themes
#   dt-theme current      print active theme
#   dt-theme wallpaper    (re)set wallpaper for active theme
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
THEMES="$REPO/themes"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE="$CFG/devdesk/current-theme"

list()    { for f in "$THEMES"/*.theme; do basename "$f" .theme; done; }
current() { cat "$STATE" 2>/dev/null || echo gruvbox; }
running() { pgrep -u "$UID" -x "$1" >/dev/null 2>&1; }

load() {
    local file="$THEMES/$1.theme"
    [[ -f $file ]] || { echo "unknown theme: $1 (try: $(list | xargs))" >&2; exit 1; }
    # shellcheck source=/dev/null
    source "$file"
}

write_i3() {
    cat > "$CFG/i3/theme.conf" <<EOT
# generated by dt-theme ($name) — do not edit
# class                 border     bg         text       indicator  child_border
client.focused          $accent    $accent    $bg        $accent    $accent
client.focused_inactive $bg_alt    $bg_alt    $fg        $bg_alt    $bg_alt
client.unfocused        $bg        $bg        $muted     $bg        $bg_alt
client.urgent           $urgent    $urgent    $bg        $urgent    $urgent
client.background       $bg
EOT
}

write_kitty() {
    {
        echo "# generated by dt-theme ($name)"
        echo "background $bg"
        echo "foreground $fg"
        echo "cursor $accent"
        echo "selection_background $bg_alt"
        echo "selection_foreground $fg"
        echo "active_tab_background $accent"
        echo "active_tab_foreground $bg"
        echo "inactive_tab_background $bg_alt"
        echo "inactive_tab_foreground $muted"
        for i in $(seq 0 15); do
            local var="color$i"
            echo "color$i ${!var}"
        done
    } > "$CFG/kitty/colors.conf"
}

write_polybar() {
    cat > "$CFG/polybar/colors.ini" <<EOT
; generated by dt-theme ($name)
[colors]
bg = $bg
bg-alt = $bg_alt
fg = $fg
muted = $muted
accent = $accent
urgent = $urgent
EOT
}

write_rofi() {
    cat > "$CFG/rofi/colors.rasi" <<EOT
/* generated by dt-theme ($name) */
* {
    bg: $bg;
    bg-alt: $bg_alt;
    fg: $fg;
    muted: $muted;
    accent: $accent;
    urgent: $urgent;
}
EOT
}

write_dunst() {
    {
        cat "$CFG/dunst/dunstrc.base"
        cat <<EOT
    frame_color = "$accent"

[urgency_low]
    background = "$bg"
    foreground = "$muted"
[urgency_normal]
    background = "$bg"
    foreground = "$fg"
[urgency_critical]
    background = "$bg"
    foreground = "$fg"
    frame_color = "$urgent"
EOT
    } > "$CFG/dunst/dunstrc"
}

wallpaper() {
    load "$(current)"
    local t; t="$(current)"
    for img in "$THEMES/wallpapers/$t".{png,jpg,jpeg}; do
        if [[ -f $img ]] && command -v feh >/dev/null; then
            feh --no-fehbg --bg-fill "$img"
            return
        fi
    done
    command -v xsetroot >/dev/null && xsetroot -solid "$bg" 2>/dev/null || true
}

reload_all() {
    [[ -n ${DISPLAY:-} ]] || return 0
    running i3      && i3-msg -q reload || true
    running polybar && "$CFG/polybar/launch.sh" || true
    running kitty   && pkill -USR1 -x kitty || true          # kitty re-reads its config
    running dunst   && { pkill -x dunst; dunst >/dev/null 2>&1 & disown; } || true
    wallpaper
}

set_theme() {
    load "$1"
    mkdir -p "$(dirname "$STATE")"
    write_i3; write_kitty; write_polybar; write_rofi; write_dunst
    echo "$1" > "$STATE"
    reload_all
    command -v notify-send >/dev/null && [[ -n ${DISPLAY:-} ]] \
        && notify-send -t 2000 "Theme" "Switched to $name" || true
    echo "theme -> $name"
}

menu() {
    local pick
    pick="$(list | rofi -dmenu -i -p theme -select "$(current)")" || exit 0
    [[ -n $pick ]] && set_theme "$pick"
}

case "${1:-}" in
    set)       set_theme "${2:?usage: dt-theme set <name>}" ;;
    menu)      menu ;;
    list)      list ;;
    current)   current ;;
    wallpaper) wallpaper ;;
    *)         sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
