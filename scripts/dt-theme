#!/usr/bin/env bash
# dt-theme — switch the whole desktop between themes in one go.
#
#   dt-theme set <name>   apply a theme (gruvbox | nord | catppuccin)
#   dt-theme menu         pick a theme with rofi
#   dt-theme list         list themes
#   dt-theme current      print active theme
#   dt-theme wall <image> build a theme from a wallpaper and apply it
#   dt-theme wallpaper    (re)set wallpaper for active theme

# shellcheck disable=SC2154  # color variables come from the sourced .theme file
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
THEMES="$REPO/themes"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE="$CFG/devdesk/current-theme"
USER_THEMES="$CFG/devdesk/themes"          # generated themes (e.g. from a wallpaper)
APPS="$CFG/devdesk"                        # devdesk's private kitty + rofi configs

list() {
    for f in "$THEMES"/*.theme "$USER_THEMES"/*.theme; do
        [[ -f $f ]] && basename "$f" .theme
    done
}
current() { cat "$STATE" 2>/dev/null || echo gruvbox; }
running() { pgrep -u "$UID" -x "$1" >/dev/null 2>&1; }

theme_file() {
    local f
    for f in "$USER_THEMES/$1.theme" "$THEMES/$1.theme"; do
        [[ -f $f ]] && { echo "$f"; return; }
    done
    echo "unknown theme: $1 (try: $(list | xargs))" >&2
    exit 1
}

load() {
    local file
    file="$(theme_file "$1")"
    wallpaper=""
    # shellcheck source=/dev/null
    source "$file"
}

write_i3() {
    cat > "$CFG/i3/theme.conf" <<EOT
# generated by dt-theme ($name) — do not edit
# class                 border     bg         text       indicator  child_border
client.focused          $accent    $accent    $bg        $accent    $accent
client.focused_inactive $bg_alt    $bg_alt    $fg        $bg_alt    $bg_alt
client.unfocused        $bg        $bg        $muted     $bg        $bg_alt
client.urgent           $urgent    $urgent    $bg        $urgent    $urgent
client.background       $bg
EOT
}

write_kitty() {
    {
        echo "# generated by dt-theme ($name)"
        echo "background $bg"
        echo "foreground $fg"
        echo "cursor $accent"
        echo "selection_background $bg_alt"
        echo "selection_foreground $fg"
        echo "active_tab_background $accent"
        echo "active_tab_foreground $bg"
        echo "inactive_tab_background $bg_alt"
        echo "inactive_tab_foreground $muted"
        for i in $(seq 0 15); do
            local var="color$i"
            echo "color$i ${!var}"
        done
    } > "$APPS/kitty/colors.conf"
}

write_polybar() {
    cat > "$CFG/polybar/colors.ini" <<EOT
; generated by dt-theme ($name)
[colors]
bg = $bg
bg-alt = $bg_alt
fg = $fg
muted = $muted
accent = $accent
urgent = $urgent
EOT
}

write_rofi() {
    cat > "$APPS/rofi/colors.rasi" <<EOT
/* generated by dt-theme ($name) */
* {
    bg: $bg;
    bg-alt: $bg_alt;
    fg: $fg;
    muted: $muted;
    accent: $accent;
    urgent: $urgent;
}
EOT
}

write_dunst() {
    {
        cat "$CFG/dunst/dunstrc.base"
        cat <<EOT
    frame_color = "$accent"

[urgency_low]
    background = "$bg"
    foreground = "$muted"
[urgency_normal]
    background = "$bg"
    foreground = "$fg"
[urgency_critical]
    background = "$bg"
    foreground = "$fg"
    frame_color = "$urgent"
EOT
    } > "$CFG/dunst/dunstrc"
}

wallpaper() {
    local t img
    t="$(current)"
    load "$t"
    for img in "$wallpaper" "$THEMES/wallpapers/$t".{png,jpg,jpeg}; do
        if [[ -f $img ]] && command -v feh >/dev/null; then
            feh --no-fehbg --bg-fill "$img"
            return
        fi
    done
    if command -v xsetroot >/dev/null; then xsetroot -solid "$bg" 2>/dev/null || true; fi
}

reload_all() {
    # only touch running apps inside an i3 session — never another desktop's
    [[ -n ${DISPLAY:-} ]] && running i3 || return 0
    if running i3;      then i3-msg -q reload || true; fi
    if running polybar; then "$CFG/polybar/launch.sh"; fi   # locked, safe to call any time
    # kitty re-reads its config on SIGUSR1 (only devdesk's kitty windows)
    pkill -USR1 -u "$UID" -f "kitty --config $APPS/kitty" || true
    if running dunst;   then pkill -x dunst; dunst >/dev/null 2>&1 & disown; fi
    wallpaper
}

set_theme() {
    load "$1"
    mkdir -p "$(dirname "$STATE")"
    write_i3; write_kitty; write_polybar; write_rofi; write_dunst
    cp "$(theme_file "$1")" "$CFG/devdesk/colors.sh"   # for the other dt-* scripts
    echo "$1" > "$STATE"
    reload_all
    if [[ -n ${DISPLAY:-} ]] && command -v notify-send >/dev/null; then
        notify-send -t 2000 "Theme" "Switched to $name" || true
    fi
    echo "theme -> $name"
}

# --- wallpaper -> theme ------------------------------------------------------
rgb() { printf '%d %d %d' "0x${1:1:2}" "0x${1:3:2}" "0x${1:5:2}"; }
lum() { local r g b; read -r r g b < <(rgb "$1"); echo $(( (299*r + 587*g + 114*b) / 1000 )); }
sat() {  # max(r,g,b) - min(r,g,b): how "colorful" it is
    local r g b hi lo
    read -r r g b < <(rgb "$1")
    hi=$(( r > g ? (r > b ? r : b) : (g > b ? g : b) ))
    lo=$(( r < g ? (r < b ? r : b) : (g < b ? g : b) ))
    echo $(( hi - lo ))
}
mix() {  # mix <hex> <hex> <percent of second>
    local r1 g1 b1 r2 g2 b2 t=$3
    read -r r1 g1 b1 < <(rgb "$1"); read -r r2 g2 b2 < <(rgb "$2")
    printf '#%02x%02x%02x' $(( r1 + (r2-r1)*t/100 )) $(( g1 + (g2-g1)*t/100 )) $(( b1 + (b2-b1)*t/100 ))
}

from_wallpaper() {
    local img im c bg fg accent best=-1
    img="$(readlink -f "$1")"
    [[ -f $img ]] || { echo "no such image: $1" >&2; exit 1; }
    im="$(command -v magick || command -v convert)" || { echo "needs imagemagick" >&2; exit 1; }

    # 8 dominant colors, sorted dark -> light
    mapfile -t palette < <("$im" "$img" -alpha off -resize 200x200 -colors 8 -unique-colors txt:- \
        | grep -o '#[0-9A-Fa-f]\{6\}' | while read -r c; do echo "$(lum "$c") $c"; done | sort -n | cut -d' ' -f2)
    (( ${#palette[@]} >= 3 )) || { echo "could not read colors from $img" >&2; exit 1; }

    bg="${palette[0]}";  while (( $(lum "$bg") > 35 ));  do bg="$(mix "$bg" "#000000" 25)"; done
    fg="${palette[-1]}"; while (( $(lum "$fg") < 205 )); do fg="$(mix "$fg" "#ffffff" 25)"; done
    for c in "${palette[@]:1:${#palette[@]}-2}"; do          # most colorful mid-tone = accent
        if (( $(sat "$c") > best )); then best=$(sat "$c"); accent="$c"; fi
    done
    while (( $(lum "$accent") < 110 )); do accent="$(mix "$accent" "#ffffff" 20)"; done

    mkdir -p "$USER_THEMES"
    cat > "$USER_THEMES/wallpaper.theme" <<EOT
# generated by: dt-theme wall $img
name="Wallpaper"
wallpaper="$img"
bg="$bg"
bg_alt="$(mix "$bg" "$fg" 12)"
fg="$fg"
muted="$(mix "$bg" "$fg" 45)"
accent="$accent"
urgent="#e06c75"

color0="$(mix "$bg" "$fg" 15)";  color8="$(mix "$bg" "$fg" 40)"
color1="#e06c75";  color9="#ef8891"
color2="#98c379";  color10="#b5e890"
color3="#e5c07b";  color11="#f2d59b"
color4="$accent";  color12="$(mix "$accent" "#ffffff" 25)"
color5="#c678dd";  color13="#d9a0eb"
color6="#56b6c2";  color14="#7fd4de"
color7="$(mix "$fg" "$bg" 15)";  color15="$fg"
EOT
    set_theme wallpaper
}

menu() {
    local pick
    pick="$(list | rofi -config "$APPS/rofi/config.rasi" -dmenu -i -p theme -select "$(current)")" || exit 0
    if [[ -n $pick ]]; then set_theme "$pick"; fi
}

case "${1:-}" in
    set)       set_theme "${2:?usage: dt-theme set <name>}" ;;
    menu)      menu ;;
    list)      list ;;
    current)   current ;;
    wall)      from_wallpaper "${2:?usage: dt-theme wall <image>}" ;;
    wallpaper) wallpaper ;;
    *)         sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
