#!/usr/bin/env bash
# dt-bar — small helpers behind the polybar modules.
#   dt-bar bluetooth | bluetooth-toggle
#   dt-bar brightness | brightness-up | brightness-down
# Printing nothing hides the module (e.g. no Bluetooth or no backlight).

BT_ON='󰂯'; BT_OFF='󰂲'; BT_CONN='󰂱'; SUN='󰃠'
COLORS="${XDG_CONFIG_HOME:-$HOME/.config}/devdesk/colors.sh"
# shellcheck source=/dev/null
[[ -r $COLORS ]] && source "$COLORS"

bt_state() { timeout 2 bluetoothctl show 2>/dev/null; }

bluetooth() {
    command -v bluetoothctl >/dev/null || return
    local state dev
    state=$(bt_state)
    [[ -z $state || $state == *"No default controller"* ]] && return
    if [[ $state == *"Powered: yes"* ]]; then
        dev=$(timeout 2 bluetoothctl devices Connected 2>/dev/null | head -1 | cut -d' ' -f3-)
        if [[ -n $dev ]]; then
            echo "%{F${accent:-#88c0d0}}$BT_CONN%{F-} $dev"
        else
            echo "%{F${accent:-#88c0d0}}$BT_ON%{F-} on"
        fi
    else
        echo "%{F${muted:-#888888}}$BT_OFF off%{F-}"
    fi
}

bluetooth_toggle() {
    if [[ $(bt_state) == *"Powered: yes"* ]]; then
        bluetoothctl power off >/dev/null
    else
        bluetoothctl power on >/dev/null
    fi
}

brightness() {
    command -v brightnessctl >/dev/null || return
    local pct
    pct=$(brightnessctl --class=backlight -m 2>/dev/null | head -1 | cut -d, -f4) || return
    [[ -n $pct ]] && echo "%{F${accent:-#88c0d0}}$SUN%{F-} $pct"
}

case "${1:-}" in
    bluetooth)        bluetooth ;;
    bluetooth-toggle) bluetooth_toggle ;;
    brightness)       brightness ;;
    brightness-up)    brightnessctl --class=backlight set +5% >/dev/null ;;
    brightness-down)  brightnessctl --class=backlight set 5%- >/dev/null ;;
    *) sed -n '2,4p' "$0" | sed 's/^# //'; exit 1 ;;
esac
