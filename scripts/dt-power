#!/usr/bin/env bash
# dt-power — small power menu in rofi (Super+Escape).
#   dt-power          show menu
#   dt-power lock     lock the screen in the current theme's colors

COLORS="${XDG_CONFIG_HOME:-$HOME/.config}/devdesk/colors.sh"
# shellcheck source=/dev/null
[[ -r $COLORS ]] && source "$COLORS"

lock() {
    local bg=${bg:-#1e1e2e}
    i3lock -n -c "${bg#\#}" &
    disown
}

[[ ${1:-} == lock ]] && { lock; exit 0; }

choice=$(printf '%s\n' lock logout suspend reboot shutdown \
    | rofi -dmenu -i -p power -theme-str 'window {width: 300px;} listview {lines: 5;}') || exit 0

confirm() {
    [[ $(printf 'no\nyes\n' | rofi -dmenu -p "$1?" -theme-str 'window {width: 300px;} listview {lines: 2;}') == yes ]]
}

case $choice in
    lock)     lock ;;
    logout)   confirm logout   && i3-msg -q exit ;;
    suspend)  lock; sleep 0.5; systemctl suspend ;;
    reboot)   confirm reboot   && systemctl reboot ;;
    shutdown) confirm shutdown && systemctl poweroff ;;
esac
