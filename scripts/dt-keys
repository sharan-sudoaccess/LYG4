#!/usr/bin/env bash
# dt-keys — searchable cheat sheet of every i3 shortcut (Super+/).
# It reads the live i3 config, so it never goes out of date.
# Pick a line and press Enter to run that action.

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/i3/config"
declare -A vars

pretty_key() {
    local k=${1//\$mod/Super}
    k=${k//+/ + }
    k=${k/Return/Enter}
    echo "$k"
}

pretty_cmd() {
    local c=$1
    c=${c#exec }; c=${c#--no-startup-id }
    c=${c//\~\/.local\/bin\//}
    c=${c/workspace number /workspace }
    echo "$c"
}

expand() {  # replace $vars defined with `set` in the i3 config
    local c=$1 v
    for v in "${!vars[@]}"; do c=${c//\$$v/${vars[$v]}}; done
    echo "$c"
}

declare -a keys cmds
in_mode=0
while read -r first rest; do
    case $first in
        set)     read -r name value <<< "$rest"; vars[${name#\$}]=${value//\"/} ;;
        mode)    in_mode=1 ;;
        "}")     in_mode=0 ;;
        bindsym) (( in_mode )) && continue
                 read -r key cmd <<< "$rest"
                 keys+=("$(pretty_key "$key")"); cmds+=("$cmd") ;;
    esac
done < "$CONF"

menu=$(for i in "${!keys[@]}"; do
    printf '%-26s %s\n' "${keys[$i]}" "$(pretty_cmd "$(expand "${cmds[$i]}")")"
done)

if [[ ${1:-} == --print || -z ${DISPLAY:-} ]]; then
    echo "$menu"; exit 0
fi

idx=$(rofi -dmenu -i -p keys -format i -theme-str 'window {width: 760px;}' <<< "$menu") || exit 0
[[ -n $idx ]] && i3-msg -q "$(expand "${cmds[$idx]}")"
